# UniAdapt AI - environment variables (Phase 1: Foundation)
# Copy to `.env` for local development. Never commit a real `.env`.
# In Docker/production, real environment variables are used instead of a
# file (python-dotenv is dev-only per ADR-0010).

ENVIRONMENT=development

# --- Database (PostgreSQL 15 + pgvector) ---
DATABASE_URL=postgresql+psycopg://uniadapt:uniadapt@localhost:5432/uniadapt

# --- Redis (rate limiting - ADR-0006) ---
REDIS_URL=redis://localhost:6379/0

# --- JWT (NFR-SEC-004) ---
# Outside ENVIRONMENT=development/test, startup fails unless this is at
# least 32 bytes and not the placeholder below - e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
JWT_SECRET_KEY=replace-with-a-long-random-value-never-committed
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=240

# --- bcrypt (NFR-SEC-005) ---
BCRYPT_ROUNDS=12

# --- Cookies / CSRF (ADR-0001) ---
COOKIE_SECURE=true
COOKIE_DOMAIN=
CORS_ALLOWED_ORIGIN=http://localhost:5173

# --- Rate limiting (ADR-0006, NFR-SEC-016) - fixed window, configurable ---
RATE_LIMIT_WINDOW_SECONDS=900
RATE_LIMIT_LOGIN_PER_ACCOUNT_PER_WINDOW=5
RATE_LIMIT_LOGIN_PER_IP_PER_WINDOW=20
RATE_LIMIT_TOKEN_CONSUME_PER_IP_PER_WINDOW=20

# --- Invitation / password-reset token lifetimes (FR-AUTH-004) ---
INVITATION_TOKEN_TTL_HOURS=72
PASSWORD_RESET_TOKEN_TTL_HOURS=2

# --- MinIO (provisioned for forward compatibility; not exercised by Phase 1) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000
