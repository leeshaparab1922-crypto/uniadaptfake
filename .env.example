# UniAdapt AI - environment variables (Phase 1: Foundation)
# Copy to `.env` for local development. Never commit a real `.env`.
# In Docker/production, real environment variables are used instead of a
# file (python-dotenv is dev-only per ADR-0010).

ENVIRONMENT=development

# --- Database (PostgreSQL 15 + pgvector) ---
DATABASE_URL=postgresql+psycopg://uniadapt:uniadapt@localhost:5432/uniadapt

# --- Redis (rate limiting - ADR-0006) ---
REDIS_URL=redis://localhost:6379/0

# --- JWT (NFR-SEC-004) ---
# Outside ENVIRONMENT=development/test, startup fails unless this is at
# least 32 bytes and not the placeholder below - e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
JWT_SECRET_KEY=replace-with-a-long-random-value-never-committed
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=240

# --- bcrypt (NFR-SEC-005) ---
BCRYPT_ROUNDS=12

# --- Cookies / CSRF (ADR-0001) ---
COOKIE_SECURE=true
COOKIE_DOMAIN=
CORS_ALLOWED_ORIGIN=http://localhost:5173

# --- Rate limiting (ADR-0006, NFR-SEC-016) - fixed window, configurable ---
RATE_LIMIT_WINDOW_SECONDS=900
RATE_LIMIT_LOGIN_PER_ACCOUNT_PER_WINDOW=5
RATE_LIMIT_LOGIN_PER_IP_PER_WINDOW=20
RATE_LIMIT_TOKEN_CONSUME_PER_IP_PER_WINDOW=20

# --- Invitation / password-reset token lifetimes (FR-AUTH-004) ---
INVITATION_TOKEN_TTL_HOURS=72
PASSWORD_RESET_TOKEN_TTL_HOURS=2

# --- MinIO (ADR-0018): one private bucket; the app uses a SCOPED credential, never the root key ---
MINIO_ENDPOINT=localhost:9000
MINIO_SECURE=false
MINIO_BUCKET=uniadapt-content
# Root credential: used only by the `minio` server and the one-shot `minio-init` bootstrap.
# docker-compose.yml blanks these inside backend/celery, which never use the root key.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# Scoped app credential, required in every environment (no fallback to the root key).
# minio-init (backend/scripts/bootstrap_minio.sh) creates this user from these two values.
# Generate the secret, e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
MINIO_APP_ACCESS_KEY=uniadapt-app
MINIO_APP_SECRET_KEY=

# --- Uploads (SRS Section 17; plan P-12) ---
UPLOAD_MAX_BYTES=26214400
# Also cap request bodies at the reverse proxy (e.g. nginx `client_max_body_size 26m;`).
RATE_LIMIT_UPLOAD_PER_TEACHER_PER_WINDOW=30

# --- Ingestion / OCR (ADR-0013, plan P-4) ---
INGEST_MIN_PAGE_CHARS=25
OCR_LANGUAGE=eng
OCR_TESSERACT_CONFIG=--oem 1 --psm 3
OCR_RENDER_DPI=300
OCR_MIN_MEAN_CONFIDENCE=60
OCR_MIN_CHARS=25
INGEST_PPTX_NOTES=true

# --- Embeddings (ADR-0015): BAAI/bge-m3 pinned to an exact HuggingFace commit ---
EMBEDDING_MODEL_ID=BAAI/bge-m3
EMBEDDING_MODEL_REVISION=5617a9f61b028005a4858fdac845db406aefb181
HF_HOME=/hf-cache
CELERY_BROKER_URL=redis://localhost:6379/0

# --- Test services (backend/scripts/test_services.sh) ---
TEST_DATABASE_URL=postgresql+psycopg://uniadapt:uniadapt@localhost:5432/uniadapt_test
TEST_MINIO_ENDPOINT=localhost:9000
# Separate scoped credential limited to the test bucket (the app credential cannot reach it).
# minio-init creates this user when TEST_MINIO_SECRET_KEY is set; Docker-backed tests need it.
TEST_MINIO_ACCESS_KEY=uniadapt-test
TEST_MINIO_SECRET_KEY=
TEST_MINIO_BUCKET=uniadapt-content-test

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000

# --- Curriculum Agent / LLM provider (Phase 2 slice 2B; ADR-0016) ---
LLM_PROVIDER=ANTHROPIC
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
LLM_MAX_OUTPUT_TOKENS=32000
LLM_TOKEN_BUDGET=400000
LLM_REPAIR_ATTEMPTS=2
# Real key goes only in your local .env or secret manager; never commit it (NFR-SEC-013).
ANTHROPIC_API_KEY=
RATE_LIMIT_GENERATE_PER_TEACHER_PER_WINDOW=10
